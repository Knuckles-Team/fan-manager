{
  "mcpServers": {
    "fan-manager": {
      "command": "uvx",
      "args": [
        "--from",
        "fan-manager",
        "fan-manager-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "condensed",
        "ENABLE_DELEGATION": "False",
        "FAN_CONTROLTOOL": "True",
        "IPMITOOL": "True",
        "IPMITOOL_PATH": "ipmitool",
        "SENSORS_PATH": "sensors",
        "TEMPERATURETOOL": "True"
      }
    }
  }
}
